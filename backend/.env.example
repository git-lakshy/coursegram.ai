# LLM provider: groq or nvidia
LLM_PROVIDER=nvidia

# Groq free key, https://console.groq.com/keys
GROQ_API_KEY=

# NVIDIA NIM key, https://build.nvidia.com
NVIDIA_API_KEY=

LLM_MODEL=google/diffusiongemma-26b-a4b-it

# Token signing secret for production (long random string). Development
# falls back to a locally generated key file.
# SECRET_KEY=change-me-to-a-long-random-string

# Comma separated browser origins allowed to call the API.
# ALLOWED_ORIGINS=https://yourdomain.com
