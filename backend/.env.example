# LLM provider: groq or nvidia
LLM_PROVIDER=nvidia

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY= # gsk_qxyz

# Alternative provider, get a key at https://build.nvidia.com
# Set LLM_PROVIDER=nvidia to use this instead of groq
NVIDIA_API_KEY= # nvapi-xyz

# Optional model override, provider defaults apply otherwise
 LLM_MODEL= 
