# LLM provider: groq or nvidia
LLM_PROVIDER=nvidia

# Groq free key, https://console.groq.com/keys
GROQ_API_KEY=

# NVIDIA NIM key, https://build.nvidia.com
NVIDIA_API_KEY=

LLM_MODEL=qwen/qwen2.5-72b-instruct

# ALLOWED_ORIGINS=https://yourdomain.com

# Firebase project for ID token verification (required for auth)
# FIREBASE_PROJECT_ID=your-project-id
