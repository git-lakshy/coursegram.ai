# LLM provider: groq or nvidia
LLM_PROVIDER=nvidia

# Groq free key, https://console.groq.com/keys
GROQ_API_KEY=

# NVIDIA NIM key, https://build.nvidia.com
NVIDIA_API_KEY=

LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# ALLOWED_ORIGINS=https://yourdomain.com

# Firebase project for ID token verification (required for auth)
# FIREBASE_PROJECT_ID=your-project-id

# Udemy Affiliate API credentials (optional; course search falls back to
# Coursera plus the curated resource set without them)
# UDEMY_CLIENT_ID=
# UDEMY_CLIENT_SECRET=
